<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Switch Payment Method</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --brand: #0ea5e9;
      --brand-dark: #0284c7;
      --card-shadow: 0 16px 36px rgba(6, 64, 97, 0.18);
    }
    body {
      background: radial-gradient(circle at 80% 20%, #e0f2fe 0, #f8fafc 35%, #ffffff 75%);
      min-height: 100vh;
      font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;
      padding: 40px 16px;
    }
    .card-shell {
      max-width: 520px;
      margin: 0 auto;
      background:#fff;
      border:1px solid #e2e8f0;
      border-radius:20px;
      box-shadow: var(--card-shadow);
      padding:26px 28px;
    }
    .pill {
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 12px;
      border-radius:999px;
      background:#e0f2fe;
      color:#0369a1;
      font-weight:600;
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:0.04em;
    }
    .btn-primary {
      background: linear-gradient(120deg, var(--brand), var(--brand-dark));
      border: none;
      box-shadow: 0 10px 24px rgba(2,132,199,0.35);
    }
  </style>
</head>
<body>
  <div class="card-shell">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="pill">Switch Method</span>
      <span class="text-muted small">Order #<%= order.id %></span>
    </div>
    <h3 class="fw-bold mb-1">Choose another way to pay</h3>
    <p class="text-muted mb-3">Amount: $<%= Number(order.final_total || order.amount || order.subtotal || 0).toFixed(2) %></p>

    <% if (order.payment_failure_reason === 'INSUFFICIENT_WALLET_BALANCE') { %>
      <div class="alert alert-warning">
        Wallet insufficient. Please retry using NETS QR or PayPal.
      </div>
    <% } %>

    <form method="POST" action="/pay/retry/<%= order.id %>">
      <%
        const currentMethod = String(order.payment_method || '').toLowerCase().replace(/\s+/g, '_');
        const options = [
          { value: 'nets_qr', label: 'NETS QR' },
          { value: 'paypal', label: 'PayPal' },
          { value: 'wallet', label: 'Wallet' }
        ].filter(opt => opt.value !== currentMethod);
      %>
      <% options.forEach((opt, idx) => { %>
        <div class="form-check mb-3">
          <input class="form-check-input" type="radio" name="method" id="retry_<%= opt.value %>" value="<%= opt.value %>" <%= idx === 0 ? 'required' : '' %>>
          <label class="form-check-label" for="retry_<%= opt.value %>"><%= opt.label %></label>
        </div>
      <% }) %>
      <button class="btn btn-primary w-100" type="submit">Continue</button>
    </form>

    <a class="text-decoration-none d-block mt-3" href="/invoice/<%= order.id %>">← Back to invoice</a>
  </div>
</body>
</html>
