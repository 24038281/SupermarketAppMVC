<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>PayPal Wallet Top-Up</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&currency=SGD"></script>
  <style>
    body { background:#f7f8fb; font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif; padding:24px; }
    .card-shell { max-width:640px; margin:0 auto; background:#fff; border:1px solid #e5e7eb; border-radius:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); padding:22px 24px; }
  </style>
</head>
<body>
  <div class="card-shell">
    <h3 class="fw-bold mb-2">Pay with PayPal</h3>
    <p class="text-muted">Top-up ID: <%= topup.id %> — Amount: $<%= Number(topup.amount || 0).toFixed(2) %></p>
    <div id="paypal-button-container"></div>
    <a class="text-decoration-none d-block mt-3" href="/wallet">← Back to wallet</a>
  </div>

  <script>
    const topupId = <%= topup.id %>;
    paypal.Buttons({
      createOrder: async function() {
        const res = await fetch('/api/paypal/topup/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topupId })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to create order');
        return data.id;
      },
      onApprove: async function(data) {
        const res = await fetch('/api/paypal/topup/capture-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topupId, orderID: data.orderID })
        });
        const result = await res.json();
        if (!res.ok) throw new Error(result.error || 'Capture failed');
        window.location.href = result.redirectUrl || '/wallet';
      },
      onCancel: async function() {
        await fetch('/api/paypal/topup/cancel', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topupId })
        });
        window.location.href = '/wallet';
      },
      onError: function(err) {
        alert(err && err.message ? err.message : 'PayPal error');
      }
    }).render('#paypal-button-container');
  </script>
</body>
</html>
