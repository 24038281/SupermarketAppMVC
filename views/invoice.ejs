<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Invoice <%= typeof invoiceNumber !== 'undefined' ? invoiceNumber : ('#' + order.id) %></title>
    <style>
        * {
            box-sizing: border-box;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        body {
            background: #f4f5f7;
            margin: 0;
            padding: 30px;
            display: flex;
            justify-content: center;
        }

        .invoice-wrapper {
            max-width: 900px;
            width: 100%;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.06);
            padding: 30px 40px;
        }

        .status-banner {
            padding: 12px 16px;
            border-radius: 10px;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .banner-success { background: #e6f4ea; color: #1d7a32; border: 1px solid #c7e6d0; }
        .banner-failed { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
        .banner-pending { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }
        .banner-info { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 1px solid #e2e4ea;
            padding-bottom: 16px;
            margin-bottom: 20px;
        }

        .invoice-title {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 4px;
        }

        .invoice-meta {
            color: #6b7280;
            font-size: 13px;
            line-height: 1.5;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            background: #e5f7eb;
            color: #198754;
            font-size: 12px;
            font-weight: 600;
        }

        .section-title {
            font-size: 18px;
            margin: 20px 0 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            font-size: 14px;
        }

        th, td {
            padding: 10px 12px;
            text-align: left;
        }

        th {
            background: #f3f4f6;
            border-bottom: 1px solid #e5e7eb;
            font-weight: 600;
        }

        tr:nth-child(even) {
            background-color: #fafafa;
        }

        tr:nth-child(odd) td {
            border-bottom: 1px solid #f0f0f0;
        }

        .text-right {
            text-align: right;
        }

        .summary-card {
            margin-top: 24px;
            margin-left: auto;
            max-width: 320px;
            border-radius: 10px;
            background: #f9fafb;
            padding: 16px 18px;
            border: 1px solid #e5e7eb;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .summary-row.total {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px dashed #d1d5db;
            font-weight: 700;
            font-size: 15px;
        }

        .summary-label-muted {
            color: #6b7280;
        }

        .discount {
            color: #b91c1c;
        }

        .btn-back {
            display: inline-block;
            margin-top: 24px;
            padding: 8px 16px;
            font-size: 14px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            color: #374151;
            text-decoration: none;
            transition: all 0.15s ease-in-out;
            background: #ffffff;
        }

        .btn-back:hover {
            background: #f3f4f6;
            border-color: #9ca3af;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 28px;
        }

        .btn-primary {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 999px;
            border: none;
            background: #2563eb;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.26);
        }

        .btn-ghost {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 999px;
            border: 1px solid #d1d5db;
            background: #ffffff;
            color: #374151;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.15s ease-in-out;
        }

        .btn-ghost:hover {
            background: #f3f4f6;
            border-color: #9ca3af;
        }

        @media (max-width: 640px) {
            body {
                padding: 12px;
            }

            .invoice-wrapper {
                padding: 20px;
            }

            .invoice-header {
                flex-direction: column;
                gap: 10px;
            }

            .summary-card {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
<div class="invoice-wrapper">
    <%
        const successMsgs = typeof successMessages !== 'undefined' ? successMessages : [];
        const errorMsgs = typeof messages !== 'undefined' ? messages : [];
        const payStatus = String(order.payment_status || order.status || 'PENDING').toUpperCase().trim();
        const isPaid = payStatus === 'PAID' || payStatus === 'SUCCESS';
        const isCancelled = payStatus === 'CANCELLED' || payStatus.includes('CANCEL');
        const isExpired = payStatus === 'EXPIRED' || payStatus.includes('EXPIRE') || payStatus === 'TIMEOUT';
        const isFailed = payStatus === 'FAILED' || isCancelled || isExpired;
        const isPending = !isPaid && !isFailed;
        const statusLabel = isPaid
            ? 'Paid'
            : (isCancelled ? 'Payment Cancelled'
                : (isExpired ? 'Payment Expired'
                    : (isFailed ? 'Payment Failed' : 'Payment Pending')));
        const badgeStyle = isPaid
            ? 'background:#e5f7eb;color:#198754;'
            : (isFailed ? 'background:#fee2e2;color:#b91c1c;' : 'background:#fff3cd;color:#b45309;');
        const paidTime = order.paid_at || order.payment_paid_at;
        const netsRef = order.nets_txn_ref || order.payment_txn_ref;
        const paymentMethodRaw = order.payment_method || order.paymentMethod || order.payment_method_recorded;
        const paymentMethodNormalized = String(paymentMethodRaw || '').toLowerCase().replace(/\s+/g, '_');
        const refundStatusRaw = String(order.refund_status || '').toUpperCase();
        let refundStatusLabel = refundStatusRaw || 'NOT REFUNDED';
        if (refundStatusRaw === 'PENDING' && String(order.payment_method || '').toLowerCase() === 'nets_qr') {
            refundStatusLabel = 'Refund pending (NETS manual settlement)';
        } else if (refundStatusRaw === 'REFUNDED') {
            refundStatusLabel = 'Refunded';
        }
        const refundRef = order.refund_txn_ref;
        const isRefunded = refundStatusRaw === 'REFUNDED';
        const refundedAt = order.refunded_at;
        const canRefund = user && user.isPrimaryAdmin && isPaid && refundStatusRaw !== 'REFUNDED';
        const refundAmount = order.refund_amount;
        const paymentFailureReason = order.payment_failure_reason;
    %>

    <% if (successMsgs && successMsgs.length) { %>
    <div class="status-banner banner-success">
        <% successMsgs.forEach(function(message) { %>
            <div><%= message %></div>
        <% }); %>
    </div>
    <% } %>

    <% if (errorMsgs && errorMsgs.length) { %>
    <div class="status-banner banner-info">
        <% errorMsgs.forEach(function(message) { %>
            <div><%= message %></div>
        <% }); %>
    </div>
    <% } %>

    <!-- Header -->
    <div class="invoice-header">
        <div>
            <p class="invoice-title"><%= isPaid ? 'Invoice' : 'Invoice (Unpaid)' %></p>
            <p class="invoice-meta">
                Invoice: <%= typeof invoiceNumber !== 'undefined' ? invoiceNumber : ('#' + order.id) %><br>
                Date:
                <%= order.created_at && order.created_at.toLocaleString
                    ? order.created_at.toLocaleString()
                    : order.created_at %><br>
                Customer: <strong><%= order.username %></strong><br>
                Email: <%= order.email %>
            </p>
        </div>
        <div class="invoice-meta" style="text-align:right;">
            <span class="badge" style="<%= badgeStyle %>"><%= statusLabel %></span><br>
            <span>Invoice: <%= typeof invoiceNumber !== 'undefined' ? invoiceNumber : ('#' + order.id) %></span><br>
            <span>Supermarket App</span><br>
            <span>Online Purchase</span>
        </div>
    </div>

    <% if (!isPaid) { %>
    <div class="status-banner <%= isFailed ? 'banner-failed' : 'banner-pending' %>">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
            <span>
                <%= isCancelled
                    ? 'Payment Cancelled. Your order is not confirmed. Please retry payment to finalize.'
                    : (isExpired
                        ? 'Payment Expired. Your order is not confirmed. Please generate a new QR to pay.'
                        : (isFailed
                            ? 'Payment Failed. Your order is not confirmed. Please retry payment to finalize.'
                            : 'Payment Pending. Please complete payment to confirm your order.')) %>
            </span>
            <a class="btn-primary" style="background:#0ea5e9;border:none;box-shadow:0 8px 18px rgba(14,165,233,0.3);" href="/pay/options/<%= order.id %>">Retry Payment</a>
        </div>
    </div>
    <% } %>

    <!-- Customer Details -->
    <h2 class="section-title">Customer Details</h2>
    <table>
        <tr>
            <th style="width:40%;">Account Name</th>
            <td><%= order.username %></td>
        </tr>
        <tr>
            <th>Account Email</th>
            <td><%= order.email %></td>
        </tr>
        <% if (order.user_id) { %>
        <tr>
            <th>Account ID</th>
            <td>#<%= order.user_id %></td>
        </tr>
        <% } %>
    </table>

    <!-- Delivery & Payment -->
    <h2 class="section-title">Delivery Information</h2>
    <table>
        <tr>
            <th style="width:40%;">Recipient Name</th>
            <td><%= order.customer_name || order.customerName || order.username %></td>
        </tr>
        <tr>
            <th>Delivery Address</th>
            <td><%= order.delivery_address || order.deliveryAddress || 'N/A' %></td>
        </tr>
        <% if (order.customer_contact || order.contactNumber) { %>
        <tr>
            <th>Contact Number</th>
            <td><%= order.customer_contact || order.contactNumber %></td>
        </tr>
        <% } %>
        <tr>
            <th>Postal Code</th>
            <td><%= order.postal_code || order.postalCode || 'N/A' %></td>
        </tr>
        <tr>
            <th>Payment Method</th>
            <td><%= paymentMethodRaw || 'N/A' %></td>
        </tr>
        <tr>
            <th>Payment Status</th>
            <td><%= statusLabel %><% if (!isPaid && paymentFailureReason) { %> — <span class="text-danger"><%= paymentFailureReason %></span><% } %></td>
        </tr>
        <% if (!isPaid && paymentFailureReason === 'INSUFFICIENT_WALLET_BALANCE') { %>
        <tr>
            <th>Payment Note</th>
            <td>Wallet insufficient, please retry using NETS or PayPal.</td>
        </tr>
        <% } %>
        <tr>
            <th>Refund Status</th>
            <td><%= refundStatusLabel %></td>
        </tr>
        <% if (refundAmount) { %>
        <tr>
            <th>Refund Amount</th>
            <td>$<%= Number(refundAmount).toFixed(2) %></td>
        </tr>
        <% } %>
        <% if (paidTime) { %>
        <tr>
            <th>Paid At</th>
            <td><%= new Date(paidTime).toLocaleString() %></td>
        </tr>
        <% } %>
        <% if (isPaid && paymentMethodNormalized === 'paypal' && order.paypal_capture_id) { %>
        <tr>
            <th>PayPal Transaction ID</th>
            <td><%= order.paypal_capture_id %></td>
        </tr>
        <% } %>
        <% if (netsRef) { %>
        <tr>
            <th>NETS Txn Ref</th>
            <td><%= netsRef %></td>
        </tr>
        <% } %>
        <% if (isRefunded && refundedAt) { %>
        <tr>
            <th>Refunded At</th>
            <td><%= new Date(refundedAt).toLocaleString() %></td>
        </tr>
        <% } %>
        <% if (refundRef) { %>
        <tr>
            <th>Refund Ref</th>
            <td><%= refundRef %></td>
        </tr>
        <% } %>
        </tr>
        <tr>
            <th>Delivery Date</th>
            <td><%= order.delivery_date || order.deliveryDate || 'N/A' %></td>
        </tr>
        <tr>
            <th>Delivery Time</th>
            <td><%= order.delivery_time || order.deliveryTime || 'N/A' %></td>
        </tr>
        <% if (order.order_notes || order.orderNotes) { %>
        <tr>
            <th>Order Notes</th>
            <td><%= order.order_notes || order.orderNotes %></td>
        </tr>
        <% } %>
    </table>

    <!-- Items -->
    <h2 class="section-title">Order Items</h2>
    <table>
        <tr>
            <th>Product</th>
            <th class="text-right">Unit Price</th>
            <th class="text-right">Qty</th>
            <th class="text-right">Total</th>
        </tr>
        <% items.forEach(item => { %>
            <tr>
                <td><%= item.product_name %></td>
                <td class="text-right">
                    $<%= Number(item.unit_price || 0).toFixed(2) %>
                </td>
                <td class="text-right"><%= item.quantity %></td>
                <td class="text-right">
                    $<%= Number(item.line_total || 0).toFixed(2) %>
                </td>
            </tr>
        <% }) %>
    </table>

    <!-- Summary -->
    <div class="summary-card">
        <div class="summary-row">
            <span class="summary-label-muted">Subtotal</span>
            <span>$<%= Number(order.subtotal || 0).toFixed(2) %></span>
        </div>
        <div class="summary-row">
            <span class="summary-label-muted">Promo Discount</span>
            <span class="discount">- $<%= Number(order.promo_discount || 0).toFixed(2) %></span>
        </div>
        <div class="summary-row">
            <span class="summary-label-muted">Loyalty Discount</span>
            <span class="discount">- $<%= Number(order.loyalty_discount || 0).toFixed(2) %></span>
        </div>
        <div class="summary-row total">
            <span><%= isPaid ? 'Total Paid' : 'Amount Due' %></span>
            <span>$<%= Number(order.final_total || 0).toFixed(2) %></span>
        </div>
    </div>

    <div class="actions">
        <a class="btn-ghost" href="/orders">Back to Orders</a>
        <% if (!isFailed && !isPending && user && user.isPrimaryAdmin) { %>
            <a class="btn-ghost" href="/admin/invoices">Back to All Invoices</a>
        <% } else if (!isFailed && !isPending) { %>
            <a class="btn-ghost" href="/shopping">Back to Shopping</a>
        <% } %>
        <% if (canRefund) {
            const paymentMethodLower = String(order.payment_method || '').toLowerCase();
            const refundAction =
                paymentMethodLower === 'paypal'
                    ? `/admin/refund/${order.id}`
                    : paymentMethodLower === 'nets_qr'
                        ? `/admin/refund/nets/${order.id}`
                        : `/admin/orders/${order.id}/refund`; // wallet/default
        %>
            <form method="POST" action="<%= refundAction %>" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <input type="number" step="0.01" min="0.01" name="amount" placeholder="Full refund by default" style="padding:8px 10px;border:1px solid #d1d5db;border-radius:8px;max-width:160px;">
                <input type="text" name="reason" placeholder="Reason (optional)" style="padding:8px 10px;border:1px solid #d1d5db;border-radius:8px;min-width:180px;">
                <button class="btn-primary" type="submit">Process Refund</button>
            </form>
        <% } %>
        <% if (user && user.isPrimaryAdmin && refundRow && String(refundRow.method || '').toLowerCase() === 'nets_qr' && String(refundRow.status || '').toUpperCase() === 'REQUESTED') { %>
            <form method="POST" action="/admin/refunds/nets/<%= refundRow.id %>/complete" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:10px;">
                <button class="btn-ghost" type="submit">Mark NETS Refund Completed</button>
            </form>
        <% } %>
    </div>
</div>
</body>
</html>
