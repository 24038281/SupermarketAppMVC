<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Complete your payment</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --brand: #0ea5e9;
      --brand-dark: #0284c7;
      --card-shadow: 0 16px 36px rgba(6, 64, 97, 0.18);
    }
    body {
      background: radial-gradient(circle at 20% 20%, #e0f2fe 0, #f8fafc 35%, #ffffff 75%);
      min-height: 100vh;
      font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;
      padding: 40px 16px;
    }
    .card-shell {
      max-width: 520px;
      margin: 0 auto;
      background:#fff;
      border:1px solid #e2e8f0;
      border-radius:20px;
      box-shadow: var(--card-shadow);
      padding:26px 28px;
    }
    .pill {
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:8px 12px;
      border-radius:999px;
      background:#e0f2fe;
      color:#0369a1;
      font-weight:600;
      font-size:13px;
      text-transform:uppercase;
      letter-spacing:0.04em;
    }
    .amount {
      font-size: 32px;
      font-weight: 800;
      color:#0f172a;
    }
    .btn-primary {
      background: linear-gradient(120deg, var(--brand), var(--brand-dark));
      border: none;
      box-shadow: 0 10px 24px rgba(2,132,199,0.35);
    }
    .btn-outline-primary {
      border-color: var(--brand);
      color: var(--brand-dark);
    }
    .btn-outline-primary:hover {
      background: var(--brand);
      color: #fff;
    }
  </style>
</head>
<body>
  <div class="card-shell">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="pill">Payment Options</span>
      <span class="text-muted small">Order #<%= orderId %></span>
    </div>
    <h3 class="fw-bold mb-1">Complete your payment</h3>
    <p class="text-muted mb-3">Choose to retry with your original method or switch to another.</p>
    <div class="d-flex align-items-end justify-content-between mb-3">
      <div>
        <div class="text-muted small">Amount due</div>
        <div class="amount">$<%= Number(order.final_total || order.amount || order.subtotal || 0).toFixed(2) %></div>
      </div>
      <div class="text-end text-muted small">
        <div>Method: <strong><%= order.payment_method || '—' %></strong></div>
      </div>
    </div>

    <div class="d-grid gap-2 mb-3">
      <% if (retryUrl) { %>
        <a class="btn btn-primary btn-lg" href="<%= retryUrl %>"><%= retryLabel %></a>
      <% } else { %>
        <button class="btn btn-primary btn-lg" disabled>Retry (original method unavailable)</button>
      <% } %>
      <a class="btn btn-outline-primary btn-lg" href="<%= switchUrl %>">Switch Payment Method</a>
    </div>

    <a class="text-decoration-none" href="/invoice/<%= orderId %>">← Back to invoice</a>
  </div>
</body>
</html>
