<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>NETS QR Top-Up</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background:#f7f8fb; font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif; padding:24px; }
    .card-shell { max-width:640px; margin:0 auto; background:#fff; border:1px solid #e5e7eb; border-radius:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); padding:22px 24px; }
  </style>
</head>
<body>
  <div class="card-shell">
    <h3 class="fw-bold mb-2">Top-Up with NETS QR</h3>
    <p class="text-muted">Top-up ID: <%= topup.id %> — Amount: $<%= Number(topup.amount || 0).toFixed(2) %></p>
    <p class="mb-3">Scan the generated NETS QR code to complete your payment. After successful payment, your wallet will be credited automatically.</p>

    <div class="alert alert-info">Please complete the payment within the NETS session time. If you cancel, you can start a new top-up.</div>

    <div class="d-flex gap-2">
      <form action="/wallet/topup/nets/<%= topup.id %>/cancel" method="POST">
        <button class="btn btn-outline-danger" type="submit">Cancel</button>
      </form>
      <a class="btn btn-link" href="/wallet">Back to wallet</a>
    </div>
  </div>
</body>
</html>
